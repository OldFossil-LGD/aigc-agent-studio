          },
          {
            "value": "en",
            "displayName": "英文"
          }
        ],
        "default": "zh",
        "originalField": "language"
      },
      "sampleRate": {
        "displayName": "采样率",
        "component": "singleButton",
        "enum": [
          {
            "value": 8000,
            "displayName": "8k"
          },
          {
            "value": 16000,
            "displayName": "16k"
          },
          {
            "value": 24000,
            "displayName": "24k"
          },
          {
            "value": 48000,
            "displayName": "48k"
          }
        ],
        "default": 24000,
        "originalField": "sample_rate"
