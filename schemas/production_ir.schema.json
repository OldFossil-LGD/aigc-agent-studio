{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc-agent-studio.local/schemas/production_ir.schema.json",
  "title": "Production IR (production-ir/v1)",
  "description": "唯一事实来源。12 块 Canonical Prompt、模型请求与审核报告都由它派生；下游不得反向覆盖 IR。字段级来源用 ValueWithProvenance。",
  "type": "object",
  "required": ["schema_version", "project", "requirements", "assets", "shots"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project": {
      "type": "object",
      "required": ["project_id", "delivery"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "delivery": {
          "type": "object",
          "required": ["aspect_ratio", "fps"],
          "properties": {
            "duration_sec": {"type": ["number", "null"]},
            "aspect_ratio": {"$ref": "#/$defs/provenanced"},
            "fps": {"$ref": "#/$defs/provenanced"},
            "resolution": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "quality_profile": {"$ref": "#/$defs/provenanced"},
        "postproduction_plan": {"$ref": "#/$defs/provenanced"},
        "audio_policy": {"$ref": "#/$defs/audio_policy"}
      },
      "additionalProperties": true
    },
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "assets": {
      "type": "object",
      "properties": {
        "characters": {"type": "array", "items": {"$ref": "#/$defs/character"}},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "props": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
      },
      "additionalProperties": true
    },
    "shots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot"}}
  },
  "$defs": {
    "provenanced": {
      "type": "object",
      "required": ["value", "source_type"],
      "properties": {
        "value": {},
        "source_type": {
          "enum": ["user_explicit", "user_derived", "script", "approved_project_policy",
                   "library_default", "agent_proposed", "tool_observation"]
        },
        "source_ref": {"type": ["string", "null"]},
        "locked": {"type": "boolean"},
        "confidence": {"type": ["number", "null"]},
        "approval_status": {"enum": ["not_required", "proposed", "approved", "rejected"]},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "required": ["requirement_id", "scope", "field_path", "operator", "value",
                   "strength", "source_type", "source_ref", "locked", "status"],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "scope": {"enum": ["project", "sequence", "scene", "shot", "asset"]},
        "field_path": {"type": "string", "minLength": 1},
        "operator": {"enum": ["equals", "in", "not_in", "minimum", "maximum", "contains", "prohibits"]},
        "value": {},
        "strength": {"enum": ["hard", "soft"]},
        "source_type": {"enum": ["user_explicit", "user_derived", "script",
                                 "approved_project_policy", "library_default", "agent_proposed"]},
        "source_ref": {"type": "string"},
        "locked": {"type": "boolean"},
        "status": {"enum": ["active", "superseded", "conflicted"]}
      },
      "additionalProperties": true
    },
    "character": {
      "type": "object",
      "required": ["character_id"],
      "properties": {
        "character_id": {"type": "string"},
        "identity_version": {"type": "string"},
        "look_id": {"type": ["string", "null"]},
        "declared": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "audio_policy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["inherit_project", "ambience_only", "dialogue_only", "silent", "custom"]},
        "allow": {"type": "array", "items": {"type": "string"}},
        "deny": {"type": "array", "items": {"type": "string"}},
        "dialogue": {"enum": ["none", "present", "unspecified"]},
        "sound_events": {"type": "array", "items": {"type": "object"}},
        "source_type": {"type": "string"}
      },
      "additionalProperties": true
    },
    "shot": {
      "type": "object",
      "required": ["shot_id", "order", "purpose", "delivery", "camera_spec", "audio_policy", "transition"],
      "properties": {
        "shot_id": {"type": "string"},
        "scene_id": {"type": ["string", "null"]},
        "order": {"type": "integer", "minimum": 0},
        "story_time": {"type": ["string", "null"]},
        "purpose": {"$ref": "#/$defs/provenanced"},
        "delivery": {
          "type": "object",
          "required": ["duration_sec"],
          "properties": {
            "duration_sec": {"$ref": "#/$defs/provenanced"},
            "aspect_ratio": {"type": ["string", "null"]},
            "fps": {"type": ["integer", "null"]}
          },
          "additionalProperties": true
        },
        "camera_spec": {"$ref": "#/$defs/provenanced"},
        "composition": {"$ref": "#/$defs/provenanced"},
        "lighting": {"$ref": "#/$defs/provenanced"},
        "camera_movement": {"$ref": "#/$defs/provenanced"},
        "timeline": {
          "type": "object",
          "properties": {
            "beats": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["start_sec", "end_sec", "action"],
                "properties": {
                  "start_sec": {"type": "number", "minimum": 0},
                  "end_sec": {"type": "number", "minimum": 0},
                  "action": {"type": "string"},
                  "sync_event_ids": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "asset_refs": {
          "type": "object",
          "properties": {
            "character_refs": {"type": "array", "items": {"type": "object"}},
            "location_id": {"type": ["string", "null"]},
            "prop_refs": {"type": "array", "items": {"type": "string"}},
            "continuity_state_id": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "audio_policy": {"$ref": "#/$defs/audio_policy"},
        "transition": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string"},
            "target_shot_id": {"type": ["string", "null"]},
            "end_state": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "validation": {
          "type": "object",
          "properties": {
            "status": {"enum": ["PASS", "WARN", "BLOCK", "UNKNOWN"]},
            "issues": {"type": "array", "items": {"type": "object"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
