{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigc-agent-studio.local/schemas/vimax_job.schema.json",
  "title": "ViMax backend job (vimax-job/v1)",
  "description": "把本库已定稿计划绑成 ViMax 会话的作业单。永不携带执行权：render.run 与 studio.generation_authorized 都恒为 false；密钥字段必须是空串。",
  "type": "object",
  "required": ["format", "workflow", "workflow_confirmation", "session", "source", "studio", "stage_bindings", "render", "commands", "config_template"],
  "additionalProperties": true,
  "properties": {
    "format": {"const": "vimax-job/v1"},
    "workflow": {"enum": ["idea2video", "script2video", "novel2video"]},
    "workflow_confirmation": {
      "type": "object",
      "required": ["explicit", "by", "value"],
      "properties": {
        "explicit": {"const": true},
        "by": {"type": "string"},
        "value": {"enum": ["idea2video", "script2video", "novel2video"]}
      },
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "required": ["session_id", "root", "artifact_authority"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "root": {"type": "string", "pattern": "^\\.working_dir/[^/]+/(idea2video|script2video|novel2video)$"},
        "mode": {"enum": ["new", "resume"]},
        "artifact_authority": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["kind", "sha256", "explicit"],
      "properties": {
        "kind": {"enum": ["idea", "script", "novel"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "explicit": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "studio": {
      "type": "object",
      "required": ["authoritative", "generation_authorized"],
      "properties": {
        "artifacts": {"type": "object"},
        "artifacts_sha256": {"type": "object"},
        "authoritative": {"const": true},
        "generation_authorized": {"const": false}
      },
      "additionalProperties": true
    },
    "stage_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["vimax_stage", "studio_source", "state"],
        "properties": {
          "vimax_stage": {"type": "string"},
          "studio_source": {"type": "string"},
          "state": {"enum": ["provided", "derived", "missing", "backend_generated"]},
          "evidence": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "render": {
      "type": "object",
      "required": ["run"],
      "properties": {
        "run": {"const": false},
        "note": {"type": "string"},
        "approval": {
          "type": ["object", "null"],
          "required": ["granted", "scope"],
          "properties": {
            "granted": {"type": "boolean"},
            "note": {"type": "string"},
            "scope": {"const": "recorded_not_executed"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd", "run"],
        "properties": {
          "cmd": {"type": "string"},
          "run": {"const": false},
          "why": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "config_template": {
      "type": "object",
      "required": ["llm", "image", "video"],
      "properties": {
        "llm": {"$ref": "#/$defs/backend"},
        "image": {"$ref": "#/$defs/backend"},
        "video": {"$ref": "#/$defs/backend"},
        "image_selection": {"type": "object"}
      },
      "additionalProperties": true
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "backend": {
      "type": "object",
      "properties": {
        "model_provider": {"type": "string"},
        "model": {"type": "string"},
        "base_url": {"type": "string"},
        "api_key": {"const": ""}
      },
      "additionalProperties": true
    }
  }
}
